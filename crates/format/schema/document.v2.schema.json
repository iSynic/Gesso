{
  "$defs": {
    "Arc": {
      "properties": {
        "innerRatio": {
          "default": 0.0,
          "description": "Inner radius as a fraction of the outer (donut), 0..1.",
          "format": "double",
          "type": "number"
        },
        "start": {
          "description": "Start angle, degrees.",
          "format": "double",
          "type": "number"
        },
        "sweep": {
          "description": "Sweep, degrees.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "start",
        "sweep"
      ],
      "type": "object"
    },
    "AssetId": {
      "description": "SHA-256 of the asset bytes",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "AssetMeta": {
      "properties": {
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mime": {
          "description": "MIME type, e.g. `image/png`.",
          "type": "string"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "mime"
      ],
      "type": "object"
    },
    "AutoLayout": {
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/Track"
          },
          "type": "array"
        },
        "crossAlign": {
          "$ref": "#/$defs/CrossAlign"
        },
        "crossGap": {
          "description": "Gap between wrapped lines or grid rows.",
          "format": "double",
          "type": "number"
        },
        "direction": {
          "$ref": "#/$defs/LayoutDirection"
        },
        "gap": {
          "format": "double",
          "type": "number"
        },
        "mainAlign": {
          "$ref": "#/$defs/MainAlign"
        },
        "padding": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Track"
          },
          "type": "array"
        },
        "wrap": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "BlendMode": {
      "enum": [
        "normal",
        "darken",
        "multiply",
        "colorBurn",
        "lighten",
        "screen",
        "colorDodge",
        "overlay",
        "softLight",
        "hardLight",
        "difference",
        "exclusion",
        "hue",
        "saturation",
        "color",
        "luminosity"
      ],
      "type": "string"
    },
    "Collection": {
      "properties": {
        "defaultMode": {
          "$ref": "#/$defs/Id"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "modes": {
          "items": {
            "$ref": "#/$defs/Mode"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/Variable"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "modes",
        "defaultMode"
      ],
      "type": "object"
    },
    "Color": {
      "description": "sRGB colour #rrggbb or #rrggbbaa",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
      "type": "string"
    },
    "ConstraintH": {
      "enum": [
        "left",
        "right",
        "leftRight",
        "center",
        "scale"
      ],
      "type": "string"
    },
    "ConstraintV": {
      "enum": [
        "top",
        "bottom",
        "topBottom",
        "center",
        "scale"
      ],
      "type": "string"
    },
    "Constraints": {
      "properties": {
        "h": {
          "$ref": "#/$defs/ConstraintH"
        },
        "v": {
          "$ref": "#/$defs/ConstraintV"
        }
      },
      "type": "object"
    },
    "CrossAlign": {
      "enum": [
        "start",
        "center",
        "end",
        "stretch",
        "baseline"
      ],
      "type": "string"
    },
    "Effect": {
      "oneOf": [
        {
          "$ref": "#/$defs/Shadow",
          "properties": {
            "type": {
              "const": "dropShadow",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Shadow",
          "properties": {
            "type": {
              "const": "innerShadow",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "radius": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "layerBlur",
              "type": "string"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "radius"
          ],
          "type": "object"
        },
        {
          "properties": {
            "radius": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "backgroundBlur",
              "type": "string"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "radius"
          ],
          "type": "object"
        }
      ]
    },
    "FillRule": {
      "enum": [
        "nonZero",
        "evenOdd"
      ],
      "type": "string"
    },
    "GradientStop": {
      "properties": {
        "color": {
          "$ref": "#/$defs/Color"
        },
        "offset": {
          "description": "0..=1 along the gradient.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "offset",
        "color"
      ],
      "type": "object"
    },
    "Id": {
      "description": "128-bit random id in base62 (22 characters; values above 2^128-1, i.e. above 7n42DGM5Tflk9n8mt7Fhc7, are rejected)",
      "pattern": "^[0-7][0-9A-Za-z]{21}$",
      "type": "string"
    },
    "ImageFit": {
      "enum": [
        "fill",
        "fit",
        "crop",
        "tile"
      ],
      "type": "string"
    },
    "LayoutChild": {
      "description": "How a node behaves as a child of an auto-layout frame.",
      "properties": {
        "absolute": {
          "description": "Ignore auto-layout and position by x/y.",
          "type": "boolean"
        },
        "alignSelf": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrossAlign"
            },
            {
              "type": "null"
            }
          ]
        },
        "gridCell": {
          "description": "Grid placement `[column, row]`, 0-based; `None` = auto-placed.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "grow": {
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "LayoutDirection": {
      "enum": [
        "horizontal",
        "vertical",
        "grid"
      ],
      "type": "string"
    },
    "MainAlign": {
      "enum": [
        "start",
        "center",
        "end",
        "spaceBetween"
      ],
      "type": "string"
    },
    "Mode": {
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "NodeKind": {
      "description": "The node's type and its type-specific data. The JSON tag is `type`.",
      "oneOf": [
        {
          "description": "A top-level infinite canvas.",
          "properties": {
            "background": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Color"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "page",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "autoLayout": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AutoLayout"
                },
                {
                  "type": "null"
                }
              ]
            },
            "clip": {
              "description": "Clip children to the frame bounds.",
              "type": "boolean"
            },
            "type": {
              "const": "frame",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "group",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "rectangle",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "arc": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Arc"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "ellipse",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "sides": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "starInnerRatio": {
              "description": "Inner radius ratio for stars (0..1); `None` = regular polygon.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "type": {
              "const": "polygon",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sides"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "line",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "paths": {
              "items": {
                "$ref": "#/$defs/PathData"
              },
              "type": "array"
            },
            "type": {
              "const": "path",
              "type": "string"
            }
          },
          "required": [
            "type",
            "paths"
          ],
          "type": "object"
        },
        {
          "properties": {
            "align": {
              "$ref": "#/$defs/TextAlign"
            },
            "autoResize": {
              "$ref": "#/$defs/TextAutoResize"
            },
            "spans": {
              "items": {
                "$ref": "#/$defs/TextSpan"
              },
              "type": "array"
            },
            "style": {
              "$ref": "#/$defs/TextStyle",
              "default": {
                "color": "#000000",
                "fontFamily": "Inter",
                "fontSize": 14.0
              }
            },
            "type": {
              "const": "text",
              "type": "string"
            },
            "verticalAlign": {
              "$ref": "#/$defs/VerticalAlign"
            }
          },
          "required": [
            "type",
            "spans"
          ],
          "type": "object"
        },
        {
          "properties": {
            "asset": {
              "$ref": "#/$defs/AssetId"
            },
            "fit": {
              "$ref": "#/$defs/ImageFit"
            },
            "type": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "type",
            "asset"
          ],
          "type": "object"
        },
        {
          "description": "A main component; its children are the component's content.",
          "properties": {
            "autoLayout": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AutoLayout"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": {
              "type": "string"
            },
            "type": {
              "const": "component",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "An instance of a component, with per-property overrides. Its content comes from the\ncomponent, so it has no children of its own.",
          "properties": {
            "component": {
              "$ref": "#/$defs/Id"
            },
            "overrides": {
              "items": {
                "$ref": "#/$defs/Override"
              },
              "type": "array"
            },
            "type": {
              "const": "instance",
              "type": "string"
            }
          },
          "required": [
            "type",
            "component"
          ],
          "type": "object"
        },
        {
          "description": "A sticky note for comments on the canvas.",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "note",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        }
      ]
    },
    "NodeTree": {
      "description": "An owned node with its subtree, in z-order (first child is drawn first).",
      "oneOf": [
        {
          "description": "A top-level infinite canvas.",
          "properties": {
            "background": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Color"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "page",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "autoLayout": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AutoLayout"
                },
                {
                  "type": "null"
                }
              ]
            },
            "clip": {
              "description": "Clip children to the frame bounds.",
              "type": "boolean"
            },
            "type": {
              "const": "frame",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "group",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "rectangle",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "arc": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Arc"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "const": "ellipse",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "sides": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "starInnerRatio": {
              "description": "Inner radius ratio for stars (0..1); `None` = regular polygon.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "type": {
              "const": "polygon",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sides"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "line",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "paths": {
              "items": {
                "$ref": "#/$defs/PathData"
              },
              "type": "array"
            },
            "type": {
              "const": "path",
              "type": "string"
            }
          },
          "required": [
            "type",
            "paths"
          ],
          "type": "object"
        },
        {
          "properties": {
            "align": {
              "$ref": "#/$defs/TextAlign"
            },
            "autoResize": {
              "$ref": "#/$defs/TextAutoResize"
            },
            "spans": {
              "items": {
                "$ref": "#/$defs/TextSpan"
              },
              "type": "array"
            },
            "style": {
              "$ref": "#/$defs/TextStyle",
              "default": {
                "color": "#000000",
                "fontFamily": "Inter",
                "fontSize": 14.0
              }
            },
            "type": {
              "const": "text",
              "type": "string"
            },
            "verticalAlign": {
              "$ref": "#/$defs/VerticalAlign"
            }
          },
          "required": [
            "type",
            "spans"
          ],
          "type": "object"
        },
        {
          "properties": {
            "asset": {
              "$ref": "#/$defs/AssetId"
            },
            "fit": {
              "$ref": "#/$defs/ImageFit"
            },
            "type": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "type",
            "asset"
          ],
          "type": "object"
        },
        {
          "description": "A main component; its children are the component's content.",
          "properties": {
            "autoLayout": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AutoLayout"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": {
              "type": "string"
            },
            "type": {
              "const": "component",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "An instance of a component, with per-property overrides. Its content comes from the\ncomponent, so it has no children of its own.",
          "properties": {
            "component": {
              "$ref": "#/$defs/Id"
            },
            "overrides": {
              "items": {
                "$ref": "#/$defs/Override"
              },
              "type": "array"
            },
            "type": {
              "const": "instance",
              "type": "string"
            }
          },
          "required": [
            "type",
            "component"
          ],
          "type": "object"
        },
        {
          "description": "A sticky note for comments on the canvas.",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "note",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/Id"
          },
          "description": "Design-token bindings: property path (e.g. `fills/0/color`, `opacity`) → variable id.",
          "type": "object"
        },
        "blend": {
          "$ref": "#/$defs/BlendMode"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/NodeTree"
          },
          "type": "array"
        },
        "constraints": {
          "$ref": "#/$defs/Constraints"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/Effect"
          },
          "type": "array"
        },
        "fills": {
          "items": {
            "$ref": "#/$defs/Paint"
          },
          "type": "array"
        },
        "flipX": {
          "type": "boolean"
        },
        "flipY": {
          "type": "boolean"
        },
        "height": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "layoutChild": {
          "$ref": "#/$defs/LayoutChild"
        },
        "locked": {
          "type": "boolean"
        },
        "maxHeight": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "maxWidth": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "minHeight": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "minWidth": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "modes": {
          "additionalProperties": false,
          "description": "Variable modes for this node and its content: collection id → mode id. Only pages,\nframes, components and instances take it; others inherit from their ancestors.",
          "patternProperties": {
            "^[0-7][0-9A-Za-z]{21}$": {
              "$ref": "#/$defs/Id"
            }
          },
          "type": "object"
        },
        "name": {
          "type": "string"
        },
        "opacity": {
          "format": "double",
          "type": "number"
        },
        "radius": {
          "$ref": "#/$defs/Radius"
        },
        "rotation": {
          "description": "Degrees, clockwise, around the node's centre.",
          "format": "double",
          "type": "number"
        },
        "sizingH": {
          "$ref": "#/$defs/Sizing"
        },
        "sizingV": {
          "$ref": "#/$defs/Sizing"
        },
        "strokes": {
          "items": {
            "$ref": "#/$defs/Stroke"
          },
          "type": "array"
        },
        "visible": {
          "type": "boolean"
        },
        "width": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Override": {
      "description": "One property override on an instance. `target` is a path of ids from the instance down to\nthe overridden node: each step is a node inside the previous step's component (a nested\ninstance is stepped through by its own id), and `[]` is the instance itself.",
      "oneOf": [
        {
          "properties": {
            "prop": {
              "const": "name",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "prop",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "prop": {
              "const": "kind",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/NodeKind"
            }
          },
          "required": [
            "prop",
            "value"
          ],
          "type": "object"
        },
        {
          "properties": {
            "prop": {
              "const": "x",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "prop",
            "value"
          ],
          "type": "object"
